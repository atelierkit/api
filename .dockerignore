# 依赖与构建产物一律在镜像内重新生成
node_modules
dist

# 版本库与 CI 配置
.git
.github
.gitignore
.gitattributes

# 环境变量：绝不能打进镜像（运行容器时通过 -e / --env-file 注入）
.env
.env.*
!.env.example

# 文档与本地杂项
docs
*.log
*.tsbuildinfo
.DS_Store

# 注：本文件作用于「构建上下文根目录」，即仓库根。
# 各子应用的 Dockerfile 放在 apps/<name>/Dockerfile，构建时用
#   docker build -f apps/<name>/Dockerfile .
# 共用这里的排除规则（Docker 只读取上下文根目录下的 .dockerignore）。
