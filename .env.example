# 应用参数
NODE_ENV=dev
PORT=3000
# 按它加载 .env.<APP_PROFILE>，留空则只读 .env
APP_PROFILE=

# 数据库参数
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_USER=username
POSTGRES_PSW=password

# Redis 参数
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PSW=
# 为 true 时启动清空缓存（慎用）
REDIS_INIT=false
# Bull 队列独立库（清缓存时按它避让，当前内置队列为进程内实现，仅保留配置位）
BULL_DB=1

# 初始化与注册
# 首次部署创建管理员时需带请求头 X-Setup-Token；留空则只接受回环/内网来源
# 建议用 openssl rand -hex 16 生成，初始化完成后可删除
SETUP_TOKEN=38f8567e9c170d64ca6588228e48c51a
# 是否开放自助注册，为 true 时 /passport/register 可用，否则返回 410
ALLOW_SIGNUP=false

# 敏感配置加密密钥（AES-256-GCM）
# 用于加密系统设置里保存的敏感值（当前是 SMTP 授权码），用 openssl rand -hex 32 生成
# 缺失时：保存邮件配置、发送邮件都会直接报错（不会退化成明文存储）
# 更换后：库里的旧密文解不开，需在「系统设置 → 邮件配置」重新填一次授权码
SETTING_KEY=57633e5358b9f44183bbdf0588a833c4f3d899c0f098c1b5ec40bf62b4986f04

# SMTP 参数 —— 已废弃（2026-11-01 起）
# 邮件配置改为在「系统设置 → 邮件配置」里维护并落库，运行时不再读取下面这五个变量。
# 保留在此仅供一次性迁移时对照，确认新配置可用后请整段删除。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_ACCOUNT=account@163.com
SMTP_PASSWORD=password
SMTP_USER=邮件服务

# 前端项目地址
WEB_URL=http://localhost:4200/
