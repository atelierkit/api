logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Package registry (personal mirror, not to be shared)
.npmrc
.yarnrc

# Tests
/coverage
/.nyc_output
.vitest/

